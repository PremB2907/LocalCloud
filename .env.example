FLOCI_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=5000
# LocalCloud-owned SNS email delivery (optional).
# All values are optional: LocalCloud works without them and clearly reports
# that email delivery is unavailable. These are example values only.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-provider-app-password
# SMTP_FROM_EMAIL=your-email@example.com
# SMTP_USE_TLS=true
